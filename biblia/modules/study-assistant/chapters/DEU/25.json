    "costumbres": {
      "c-0a4fa81886011238": {
        "fuente": {
          "entradaId": "freeman-209",
          "modulo": "freeman-manners-customs"
        },
        "texto": "Thou shalt not have in thy bag divers weights, a great and a small.",
        "traduccion": {
          "resourceId": "freeman-209",
          "sourceHash": "414619009703c2691ab59896fa83578012f3cbb549faef25b301f8ccbc0f7a65",
