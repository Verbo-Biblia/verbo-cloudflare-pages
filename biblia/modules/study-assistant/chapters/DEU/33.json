  "resources": {
    "costumbres": {
      "c-533c9674bdc0a0e4": {
        "fuente": {
          "entradaId": "freeman-213",
          "modulo": "freeman-manners-customs"
        },
        "texto": "This refers to the primitive method of treading the olives in order to express the oil. It is not now practiced, and could only be done when the olives were very soft. There is a similar allusion in Micah 6: 15. See also the note on Job 29:6 (#418)."
      },
      "c-ad892961869fe6d5": {
        "fuente": {
          "entradaId": "freeman-214",
          "modulo": "freeman-manners-customs"
        },
        "texto": "By this bold image Moses represents the protecting power of God; thus reversing the idea of the Egyptians, who had pictures of the god Horus with inverted head and outstretched arms over the earth. This was one mode by which they represented the vault of heaven, as is shown in th…"
      }
    },
