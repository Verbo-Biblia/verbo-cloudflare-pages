    "historia": {
      "h-2eed67b5289da553": {
        "fuente": {
          "claimIds": [
            "maclear-attributed-institutional-context"
          ],
          "contrastSourceIds": [],
          "entradaId": "maclear-1894-b04-c03",
          "fichaId": "maclear-asst-lev-1-sacrifices",
          "libroSeccion": "Book 4, Chapter 3 — The Sacrifices and Offerings",
          "modulo": "maclear-class-book-ot-history",
          "recursoId": "maclear-asst-lev-1-sacrifices"
        },
        "texto": "Maclear organiza las ofrendas en dos grupos: sin derramamiento de sangre y con sacrificio de una víctima. Dentro del segundo distingue holocaustos, ofrendas de paz y ofrendas por el pecado y la culpa. Su comparación destaca que el holocausto culmina en la consumición sobre el altar y la ofrenda de paz en una comida compartida. Es una clasificación explicativa atribuida a Maclear, que debe cotejarse con las disposiciones particulares de Levítico 1–7.",
        "tipo": "institutional-context",
        "traduccion": {
          "resourceId": "maclear-asst-lev-1-sacrifices",
          "sourceHash": "1c404727f580e7b98968bd8563f3fcb93d8089bf44afd31cdab750ac1919348a",
          "sourceLanguage": "es"
        },
        "traducciones": {
          "en": "Maclear groups offerings into those without bloodshed and those involving an animal victim. Within the second group he distinguishes burnt offerings, peace offerings, and sin and guilt offerings. His comparison emphasizes that the burnt offering culminates in consumption on the altar, while the peace offering culminates in a shared meal. This explanatory classification is attributed to Maclear and should be read alongside the individual provisions of Leviticus 1–7."
        }
      },
      "h-f5f77e85f7bd3995": {
        "fuente": {
          "entradaId": "LEV:libro",
          "libroSeccion": "LEV:libro",
          "modulo": "book-classification-ot"
        },
        "texto": "Dado en el Sinaí, dentro del primer año tras el éxodo (fecha temprana). Sin introducción propia de JFB ni Poole en el repositorio.",
        "tipo": "circunstancia",
        "traduccion": {
          "resourceId": "LEV:libro",
          "sourceHash": "be8b391fa20608d08721740047492271ea9d7907b24438657b5066ad046dec5e",
          "sourceLanguage": "es"
        }
      }
    }
  },
