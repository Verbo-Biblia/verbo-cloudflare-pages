    "costumbres": {
      "c-3f28d1068150b362": {
        "fuente": {
          "entradaId": "freeman-176",
          "modulo": "freeman-manners-customs"
        },
        "texto": "The reference here is to the Jewish mode of tithing sheep. As the sheep passed through a narrow gate, one by one, the person counting stood by, holding in his hand a rod colored with ocher. Every tenth one he touched with his rod, thus putting a mark upon it. Jeremiah alludes to…",
        "traduccion": {
          "resourceId": "freeman-176",
          "sourceHash": "3a4489ff415c67c7e75092212965e71a5b77fe0df3f7331b9fad981faab960f7",
          "sourceLanguage": "en"
        }
      },
      "c-8647a1531467440a": {
        "fuente": {
          "entradaId": "freeman-175",
          "modulo": "freeman-manners-customs"
        },
        "texto": "All thy estimations shall be according to the shekel of the sanctuary: twenty gerahs shall be the shekel.",
        "traduccion": {
          "resourceId": "freeman-175",
          "sourceHash": "4e1472db708f95d0433757387aef3bc8122836dfb555652286358c8188bf7348",
          "sourceLanguage": "en"
        }
      }
    },
