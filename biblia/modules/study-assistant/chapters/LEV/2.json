    "costumbres": {
      "c-8a40130b144151e9": {
        "fuente": {
          "entradaId": "freeman-149",
          "modulo": "freeman-manners-customs"
        },
        "texto": "Maimonides assigns as a reason for this law that it was “the practice of the idolaters to offer only leavened bread, and to choose sweet things for their oblations, and to anoint or besmear them with honey” (Reasons, etc., p. 275).",
        "traduccion": {
          "resourceId": "freeman-149",
          "sourceHash": "c4b60b978941a410651e60a090647f1aa4920478093e1aad8d51d19df5d1e533",
          "sourceLanguage": "en"
        }
      },
      "c-cdfb2f5128880c00": {
        "fuente": {
          "entradaId": "freeman-150",
          "modulo": "freeman-manners-customs"
        },
        "texto": "The reason for this law, according to Maimonides, was found in the fact that the heathen never offered salt in sacrifices. If this were the case in the time of Moses, their custom must have changed subsequently, since there is abundant evidence of this use of salt among heathen o…",
        "traduccion": {
          "resourceId": "freeman-150",
          "sourceHash": "2b013898e5047e59eb9de223a66ec27442fb2e9750a92c1352b1c95e04f8f886",
          "sourceLanguage": "en"
        }
      }
    },
