    "costumbres": {
      "c-2ec587121ec58544": {
        "fuente": {
          "entradaId": "freeman-260",
          "modulo": "freeman-manners-customs"
        },
        "texto": "According to an ancient Asiatic custom, when a dart was thrown at a freedman, and he escaped from it by flight, he was thereby absolved from all allegiance to his master. Thus Saul by his murderous fury gave complete liberty to David, whose subsequent acts of war against the king…",
        "traduccion": {
          "resourceId": "freeman-260",
          "sourceHash": "beb0e22a7bc1898144314630f284b33086430795aecd407f11482127c1827d72",
          "sourceLanguage": "en"
        }
      },
      "c-f565cbadbb17990a": {
        "fuente": {
          "entradaId": "freeman-261",
          "modulo": "freeman-manners-customs"
        },
        "texto": "This does not mean absolutely without any clothing. A person was called naked whose outer garments were thrown aside, leaving nothing but the tunic and girdle. See note on John 19:23 (#821). Thus Isaiah was naked by simply removing his sackcloth mantle (Isa. 20:2). This is also t…",
        "traduccion": {
          "resourceId": "freeman-261",
          "sourceHash": "95fa3e260e692ae1d8944f88d092494d0aea97a1c725acec761c4c7d74cd2347",
          "sourceLanguage": "en"
        }
      }
    },
