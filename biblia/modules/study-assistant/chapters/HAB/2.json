  "resources": {
    "costumbres": {
      "c-7e35832dfcb5cf42": {
        "fuente": {
          "entradaId": "freeman-618",
          "modulo": "freeman-manners-customs"
        },
        "texto": "Kaphis,“beam,” is supposed by some to be a cross-beam for binding together the walls of a building. Jerome says it is “the beam which is placed in the middle of any building to hold the walls together, and is generally called ἱμάντωσις by the Greeks.” Henderson, however, objects…"
      },
      "c-e2719d77f2a207cc": {
        "fuente": {
          "entradaId": "freeman-619",
          "modulo": "freeman-manners-customs"
        },
        "texto": "There may be a reference here to the profound and impressive silence which prevails in Oriental courts among the guards and officers who attend upon royal personages."
      }
    },
