    "historia": {
      "h-5cd08a9eaeac73d6": {
        "fuente": {
          "claimIds": [
            "maclear-attributed-geographical-context"
          ],
          "contrastSourceIds": [],
          "entradaId": "maclear-1894-b06-c03",
          "fichaId": "maclear-asst-jos-13-land-division",
          "libroSeccion": "Book 6, Chapter 3 — Battle of Merom and Division of the Land",
          "modulo": "maclear-class-book-ot-history",
          "recursoId": "maclear-asst-jos-13-land-division"
        },
        "texto": "Maclear ordena los territorios al oeste del Jordán en tres zonas: sur, centro y norte. Vincula sus montañas, llanuras y accesos con la posición de las tribus, y distingue esa distribución de las ciudades asignadas a los levitas entre las demás tribus. Su panorama permite ubicar las listas de Josué 13–21; las delimitaciones y explicaciones geográficas conservan el conocimiento y la nomenclatura de 1894.",
        "tipo": "geographical-context",
        "traduccion": {
          "resourceId": "maclear-asst-jos-13-land-division",
          "sourceHash": "9b9c095e2becab154eea43eaefea68d9aa6c0dd61aa184da905d740ed2931d74",
          "sourceLanguage": "es"
        },
        "traducciones": {
          "en": "Maclear organizes the territories west of the Jordan into three regions: south, centre and north. He relates their mountains, plains and routes to the position of the tribes, distinguishing that distribution from the cities assigned to the Levites among the other tribes. His overview helps locate the lists in Joshua 13–21; its boundaries and geographical explanations retain the knowledge and terminology of 1894."
        }
      },
      "h-aeb6492b25a5dc94": {
        "fuente": {
          "entradaId": "JOS:libro",
          "libroSeccion": "JOS:libro",
          "modulo": "book-classification-ot"
        },
        "texto": "Conquista y reparto inicial de Canaán (fecha temprana). Sin introducción propia de JFB en el repositorio; Poole sí la tiene.",
        "tipo": "circunstancia",
        "traduccion": {
          "resourceId": "JOS:libro",
          "sourceHash": "f9a550657da18e0fbaa8cda33afe476ebb735f69051b8741e6ba22f4d37db7e3",
          "sourceLanguage": "es"
        }
      }
    }
