    "historia": {
      "h-0773e8b9b91dfa05": {
        "fuente": {
          "entradaId": "EXO:libro",
          "libroSeccion": "EXO:libro",
          "modulo": "book-classification-ot"
        },
        "texto": "Rango 'fecha temprana' del éxodo (basado en 1 Reyes 6:1, cronología tradicional). JFB no tiene introducción propia a Éxodo en el repositorio (empieza directo en Éx 1); Poole tampoco.",
        "tipo": "circunstancia",
        "traduccion": {
          "resourceId": "EXO:libro",
          "sourceHash": "95ecfd98504005786ef5c5466fbefda806bcf3302961e204aad4bb1dbe83289e",
          "sourceLanguage": "es"
        }
      },
      "h-c1ae53b549a12bc6": {
        "fuente": {
          "claimIds": [
            "maclear-attributed-institutional-context"
          ],
          "contrastSourceIds": [],
          "entradaId": "maclear-1894-b04-c01",
          "fichaId": "maclear-asst-exo-36-tabernacle",
          "libroSeccion": "Book 4, Chapter 1 — The Tabernacle",
          "modulo": "maclear-class-book-ot-history",
          "recursoId": "maclear-asst-exo-36-tabernacle"
        },
        "texto": "Maclear interpreta el tabernáculo como la tienda del soberano en medio de un pueblo que viaja: su carácter transportable corresponde a la vida del campamento. Distingue el atrio, el lugar santo y el lugar santísimo como espacios con acceso y funciones diferentes. Esta explicación pertenece a su exposición de 1894; sus simbolismos no constituyen una reconstrucción arqueológica moderna.",
        "tipo": "institutional-context",
        "traduccion": {
          "resourceId": "maclear-asst-exo-36-tabernacle",
          "sourceHash": "2b5d7bf3b0fa7adb7d743a1dd118b3a1000f47d5a21dfd63af4fe10612de614b",
          "sourceLanguage": "es"
        },
        "traducciones": {
          "en": "Maclear interprets the tabernacle as the sovereign’s tent among a travelling people: its portability corresponds to life in the camp. He distinguishes the court, the Holy Place and the Holy of Holies as spaces with different access and functions. This explanation belongs to his 1894 account; its symbolism is not a modern archaeological reconstruction."
        }
      }
    }
  },
