    "historia": {
      "h-0773e8b9b91dfa05": {
        "fuente": {
          "entradaId": "EXO:libro",
          "libroSeccion": "EXO:libro",
          "modulo": "book-classification-ot"
        },
        "texto": "Rango 'fecha temprana' del éxodo (basado en 1 Reyes 6:1, cronología tradicional). JFB no tiene introducción propia a Éxodo en el repositorio (empieza directo en Éx 1); Poole tampoco.",
        "tipo": "circunstancia",
        "traduccion": {
          "resourceId": "EXO:libro",
          "sourceHash": "95ecfd98504005786ef5c5466fbefda806bcf3302961e204aad4bb1dbe83289e",
          "sourceLanguage": "es"
        }
      },
      "h-9efcdac2016a28ca": {
        "fuente": {
          "claimIds": [
            "maclear-attributed-legal-context"
          ],
          "contrastSourceIds": [],
          "entradaId": "maclear-1894-b04-c06",
          "fichaId": "maclear-asst-exo-21-civil-law",
          "libroSeccion": "Book 4, Chapter 6 — Civil and Moral Laws",
          "modulo": "maclear-class-book-ot-history",
          "recursoId": "maclear-asst-exo-21-civil-law"
        },
        "texto": "Maclear organiza la legislación civil en deberes familiares y deberes como miembro de la nación. En estos últimos distingue la protección de la vida, la reputación y la propiedad; así relaciona las disposiciones sobre homicidio, falso testimonio, robo y daños. Esta clasificación ayuda a recorrer Éxodo 21–23 junto con sus paralelos en Deuteronomio. Sus comparaciones jurídicas y valoraciones pertenecen al autor de 1894.",
        "tipo": "legal-context",
        "traduccion": {
          "resourceId": "maclear-asst-exo-21-civil-law",
          "sourceHash": "96663ce4aed7edaf57a9ac92e796eb69946099bf2c88b5da1f53d391acfa6df0",
          "sourceLanguage": "es"
        },
        "traducciones": {
          "en": "Maclear organizes civil legislation into family duties and duties as a member of the nation. Within the latter he distinguishes protection of life, reputation and property, connecting provisions on homicide, false testimony, theft and damage. This classification helps readers navigate Exodus 21–23 alongside its parallels in Deuteronomy. His legal comparisons and assessments belong to the 1894 author."
        }
      }
    }
  },
