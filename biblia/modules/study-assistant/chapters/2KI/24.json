    "historia": {
      "h-05f2373df6d599d2": {
        "fuente": {
          "claimIds": [
            "maclear-attributed-imperial-context"
          ],
          "contrastSourceIds": [],
          "entradaId": "maclear-1894-b10-c16",
          "fichaId": "maclear-asst-2ki-24-judah-captivity",
          "libroSeccion": "Book 10, Chapter 16 — Death of Josiah and Captivity of Judah",
          "modulo": "maclear-class-book-ot-history",
          "recursoId": "maclear-asst-2ki-24-judah-captivity"
        },
        "texto": "Maclear relaciona los últimos reinados de Judá con la competencia entre Egipto y Babilonia por las rutas de Siria y Palestina. Destaca la posición de Carquemis en el paso del Éufrates y reúne noticias de Reyes, Crónicas y Jeremías para explicar los cambios de dependencia política. Este marco complementa 2 Reyes 23:31–25:26; sus fechas y armonizaciones pertenecen al autor.",
        "tipo": "imperial-context",
        "traduccion": {
          "resourceId": "maclear-asst-2ki-24-judah-captivity",
          "sourceHash": "b40708218880938e6853814c8f2fd8debcffa23e4386e2ae537a206145c78fec",
          "sourceLanguage": "es"
        },
        "traducciones": {
          "en": "Maclear relates Judah’s last reigns to competition between Egypt and Babylon for the routes of Syria and Palestine. He highlights Carchemish’s position at the Euphrates crossing and brings together accounts from Kings, Chronicles and Jeremiah to explain changing political dependence. This framework complements 2 Kings 23:31–25:26; its dates and harmonizations belong to the author."
        }
      },
      "h-36ba12e9a583384f": {
        "fuente": {
          "entradaId": "2KI:libro",
          "libroSeccion": "2KI:libro",
          "modulo": "book-classification-ot"
        },
        "texto": "Continúa hasta la liberación de Joaquín en Babilonia. Sin introducción propia de JFB ni Poole en el repositorio.",
        "tipo": "circunstancia",
        "traduccion": {
          "resourceId": "2KI:libro",
          "sourceHash": "8603099129c4c38eae32d35b0ac8d1c06359482a0c09156f43ec032efe5d09f5",
          "sourceLanguage": "es"
        }
      }
    }
  },
