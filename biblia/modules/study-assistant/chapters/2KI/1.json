  "resources": {
    "costumbres": {
      "c-133549131122a1e4": {
        "fuente": {
          "entradaId": "freeman-324",
          "modulo": "freeman-manners-customs"
        },
        "texto": "Baal-zebub is, literally, “the fly-god”; but whether this name was given in honor or in contempt is not known. It may have been at first a name of contempt, which afterward, by general use, lost its original significance. Some suppose this god to have been one of the medical idol…",
        "traduccion": {
          "resourceId": "freeman-324",
          "sourceHash": "4b1ca2f74c78db45676863c692c4476341f38742dcd1a5f7026ad19112b0eefb",
          "sourceLanguage": "en"
        }
      },
      "c-d8eb89b4d4190cdc": {
        "fuente": {
          "entradaId": "freeman-325",
          "modulo": "freeman-manners-customs"
        },
        "texto": "The royal bed was probably made, as beds are now in the houses of wealthy Orientals, on the divan, which is a platform about three to four feet in width, extending sometimes across one end of the room and sometimes around three sides. It is used as a sofa by day, and as a sleepin…",
        "traduccion": {
          "resourceId": "freeman-325",
          "sourceHash": "99c6a389742c75f2363d842b88e694995c061bdb4bb0ec758f69c05aebfa09af",
          "sourceLanguage": "en"
        }
      }
    },
