    "historia": {
      "h-446b1233b9e29ca1": {
        "fuente": {
          "claimIds": [
            "maclear-attributed-historical-context"
          ],
          "contrastSourceIds": [],
          "entradaId": "maclear-1894-b07-c01",
          "fichaId": "maclear-asst-jdg-2-judges-period",
          "libroSeccion": "Book 7, Chapter 1 — Events Subsequent to the Death of Joshua",
          "modulo": "maclear-class-book-ot-history",
          "recursoId": "maclear-asst-jdg-2-judges-period"
        },
        "texto": "Maclear distingue la ausencia de un sucesor de Josué de la ausencia de gobierno: según su exposición, continuaban actuando jefes de tribus, clanes y casas, mientras el santuario permanecía en Silo. Este marco ayuda a situar el cambio generacional de Jueces 2:6–3:6 y la convivencia con poblaciones que seguían ocupando partes del territorio. La organización se presenta como la explicación histórica de Maclear.",
        "tipo": "historical-context",
        "traduccion": {
          "resourceId": "maclear-asst-jdg-2-judges-period",
          "sourceHash": "329a6b8d212b9ca884c0e1cbb9f15bf140d32800ba4b3b4e8917970bc757a6b2",
          "sourceLanguage": "es"
        },
        "traducciones": {
          "en": "Maclear distinguishes the absence of a successor to Joshua from an absence of government: in his account, chiefs of tribes, clans and households continued to act, while the sanctuary remained at Shiloh. This framework helps place the generational change in Judges 2:6–3:6 and coexistence with populations still occupying parts of the land. This organization is presented as Maclear’s historical explanation."
        }
      },
      "h-e331deda66b4541c": {
        "fuente": {
          "entradaId": "JDG:libro",
          "libroSeccion": "JDG:libro",
          "modulo": "book-classification-ot"
        },
        "texto": "Del fin de la conquista al inicio de la monarquía (Saúl). Sin introducción propia de JFB en el repositorio; Poole sí la tiene y ubica el apéndice final (Jue 19-21) 'en el reinado de Saúl'.",
        "tipo": "circunstancia",
        "traduccion": {
          "resourceId": "JDG:libro",
          "sourceHash": "ad8c0d124b4fd1e2eb8f2be99b90473cb89192c874bc049392d2185ce65e8dc6",
          "sourceLanguage": "es"
        }
      }
    }
  },
