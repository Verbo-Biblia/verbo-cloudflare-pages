  "resources": {
    "costumbres": {
      "c-4635a6d7ca8b25dc": {
        "fuente": {
          "entradaId": "freeman-504",
          "modulo": "freeman-manners-customs"
        },
        "texto": "The Hebrews were directed not to pick their grapes closely, but to leave a few for the poor. See Leviticus 19:10; Deuteronomy 24:21. This merciful provision is referred to by Gideon when he represents “the gleaning of the grapes of Ephraim” as “better than the vintage of Abi-ezer…"
      },
      "c-a691a7c4a7399392": {
        "fuente": {
          "entradaId": "freeman-505",
          "modulo": "freeman-manners-customs"
        },
        "texto": "Lowth (W.) suggests that there is a reference here “to the custom of kings, who used to confine the chief commanders of their enemies whom they take prisoners and reserve them for some extraordinary day of triumph, and then bring them out to public punishment” (Commentary in loco…"
      }
    },
