          "sourceHash": "218edc2398ff315107c5218d61996631e9f5c8e0db09b182e871e67648669fd7",
          "sourceLanguage": "en"
        }
      },
      "c-da46865c6dff2749": {
        "fuente": {
          "entradaId": "freeman-604",
          "modulo": "freeman-manners-customs"
        },
        "texto": "And I will smite the winter house with the summer house; and the houses of ivory shall perish.",
