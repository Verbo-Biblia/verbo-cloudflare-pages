        }
      },
      "c-8a927bfc64b99e33": {
        "fuente": {
          "entradaId": "freeman-606",
          "modulo": "freeman-manners-customs"
        },
        "texto": "The divan on which the beds were spread, or the frames on which they rested, were inlaid and ornamented with ivory. Compare the note on “houses of ivory” (Amos 3:15 #604).",
