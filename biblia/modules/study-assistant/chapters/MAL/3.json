    "costumbres": {
      "c-b43df8895d6ec1c1": {
        "fuente": {
          "entradaId": "freeman-626",
          "modulo": "freeman-manners-customs"
        },
        "texto": "The precise character of all the articles used by the ancient fullers is unknown. They had mineral alkali in niter, to which reference is made in Proverbs 25:20 and Jeremiah 2:22. They obtained vegetable alkali, as the Arabs do at the present time, from the ashes of some plants a…",
        "traduccion": {
          "resourceId": "freeman-626",
          "sourceHash": "e2e5d0274c55fc234dc2ac7a9a8b99774acffcfff9aa310c5a2fcfd176bbac16",
          "sourceLanguage": "en"
        }
      },
      "c-bd6740bb87fff463": {
        "fuente": {
          "entradaId": "freeman-627",
          "modulo": "freeman-manners-customs"
        },
        "texto": "The metaphor is supposed to be taken from the ancient Persian custom of keeping a record of the names and deeds of any who had rendered special service to the king. It was in this way that the faithfulness of Mordecai in revealing to Ahasuerus the plot against his life was record…",
        "traduccion": {
          "resourceId": "freeman-627",
          "sourceHash": "9e89f572614fea1318448a3dea4796267e2b0b31e2c522407b9608e5891f7fcc",
          "sourceLanguage": "en"
        }
      }
    },
