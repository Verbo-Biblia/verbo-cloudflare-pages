  "resources": {
    "costumbres": {
      "c-3f0caf0a05b0bb3e": {
        "fuente": {
          "entradaId": "freeman-297",
          "modulo": "freeman-manners-customs"
        },
        "texto": "This was the eighth month of the sacred year, and answered nearly to our November."
      },
      "c-678ccd88e0025897": {
        "fuente": {
          "entradaId": "freeman-295",
          "modulo": "freeman-manners-customs"
        },
        "texto": "The idea of the temple did not originate with Solomon, but with David, who was not permitted to carry out his intention because he had been a man of war (1 Chron. 28:2-3). God gave him a plan for the temple, as he had previously given Moses the plan for the tabernacle. This plan…"
      },
      "c-a50b01996de2fe50": {
        "fuente": {
          "entradaId": "freeman-296",
          "modulo": "freeman-manners-customs"
        },
        "texto": "This was the second month of the sacred year of the Hebrews, and corresponded nearly to our month of May."
      }
    },
