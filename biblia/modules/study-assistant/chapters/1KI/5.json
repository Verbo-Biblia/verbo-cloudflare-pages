    "historia": {
      "h-695377df9106893f": {
        "fuente": {
          "claimIds": [
            "maclear-attributed-institutional-context"
          ],
          "contrastSourceIds": [],
          "entradaId": "maclear-1894-b09-c07",
          "fichaId": "maclear-asst-1ki-5-temple",
          "libroSeccion": "Book 9, Chapter 7 — The Building of the Temple",
          "modulo": "maclear-class-book-ot-history",
          "recursoId": "maclear-asst-1ki-5-temple"
        },
        "texto": "Maclear compara el templo con el tabernáculo: un santuario permanente, de materiales más costosos, que conserva la distinción entre lugar santo y lugar santísimo. Reúne además los datos de Reyes y Crónicas sobre la cooperación con Tiro y el trabajo de artesanos y transportistas. La comparación ayuda a leer 1 Reyes 5–8; los detalles arquitectónicos y las armonizaciones se atribuyen a la obra de 1894.",
        "tipo": "institutional-context",
        "traduccion": {
          "resourceId": "maclear-asst-1ki-5-temple",
          "sourceHash": "84b061617523e6a1e524d88a8cdabcae50584a47597a4c8a9284c8092025cf5c",
          "sourceLanguage": "es"
        },
        "traducciones": {
          "en": "Maclear compares the temple with the tabernacle: a permanent sanctuary of more costly materials that preserves the distinction between the Holy Place and the Holy of Holies. He also brings together details from Kings and Chronicles about cooperation with Tyre and the work of artisans and porters. The comparison helps readers approach 1 Kings 5–8; architectural details and harmonizations are attributed to the 1894 work."
        }
      },
      "h-ce202a5b390a9bc1": {
        "fuente": {
          "entradaId": "1KI:libro",
          "libroSeccion": "1KI:libro",
          "modulo": "book-classification-ot"
        },
        "texto": "De Salomón al reino dividido, hasta cerca del reinado de Ocozías de Israel. Sin introducción propia de JFB en el repositorio; Poole sí la tiene.",
        "tipo": "circunstancia",
        "traduccion": {
          "resourceId": "1KI:libro",
          "sourceHash": "06de43fd9dd082bbd59915d8149ea0c06778da3ac3e38cd33c14a9a705d46c2c",
          "sourceLanguage": "es"
        }
      }
    }
  },
