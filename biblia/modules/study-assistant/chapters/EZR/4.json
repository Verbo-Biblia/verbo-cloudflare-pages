    "historia": {
      "h-09e7cf14518bd4e5": {
        "fuente": {
          "entradaId": "EZR:libro",
          "libroSeccion": "EZR:libro",
          "modulo": "book-classification-ot"
        },
        "texto": "Del decreto de Ciro al regreso de Esdras 'en el séptimo año de Artajerjes'. Sin introducción propia de JFB en el repositorio; Poole sí la tiene.",
        "tipo": "circunstancia",
        "traduccion": {
          "resourceId": "EZR:libro",
          "sourceHash": "7f0c8af834b6cbb7ca292adcf0fa7a4f4c551bb2eb0bf5ac20daa1a7ecfface7",
          "sourceLanguage": "es"
        }
      },
      "h-45b3d2d192c8361b": {
        "fuente": {
          "claimIds": [
            "maclear-attributed-imperial-context"
          ],
          "contrastSourceIds": [],
          "entradaId": "maclear-1894-b11-c03",
          "fichaId": "maclear-asst-ezr-1-persian-restoration",
          "libroSeccion": "Book 11, Chapter 3 — Rebuilding of the Temple, Esther and Ahasuerus",
          "modulo": "maclear-class-book-ot-history",
          "recursoId": "maclear-asst-ezr-1-persian-restoration"
        },
        "texto": "Maclear presenta la reconstrucción del templo como un proceso sujeto a la administración persa: autorización real, intervención de autoridades provinciales y consulta de archivos para resolver disputas. Relaciona ese marco con el impulso de Hageo y Zacarías, de modo que Esdras 1–6 se lee también junto a los libros proféticos. Sus identificaciones de reyes y la secuencia cronológica propuesta permanecen atribuidas a la obra de 1894.",
        "tipo": "imperial-context",
        "traduccion": {
          "resourceId": "maclear-asst-ezr-1-persian-restoration",
          "sourceHash": "0834ea47b2eb0f84b25411a09cbd74d43b65942e97d700006c835a25598aaa3f",
          "sourceLanguage": "es"
        },
        "traducciones": {
          "en": "Maclear presents the rebuilding of the temple as a process subject to Persian administration: royal authorization, intervention by provincial officials and consultation of archives to settle disputes. He connects this framework with the encouragement of Haggai and Zechariah, allowing Ezra 1–6 to be read alongside the prophetic books. His identifications of kings and proposed chronology remain attributed to the 1894 work."
        }
      }
    }
  },
