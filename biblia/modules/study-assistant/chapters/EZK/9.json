  "resources": {
    "costumbres": {
      "c-28821eb8e0a7053e": {
        "fuente": {
          "entradaId": "freeman-571",
          "modulo": "freeman-manners-customs"
        },
        "texto": "This mark was to be put on these faithful ones for their protection when the faithless were to be destroyed. It showed that they belonged to God. The allusion is to a very ancient custom. In Egypt a runaway slave was freed from his master if he went to the temple and gave himself…"
      },
      "c-ed757a8dc79a6a9c": {
        "fuente": {
          "entradaId": "freeman-570",
          "modulo": "freeman-manners-customs"
        },
        "texto": "It is still customary in the East to put into the girdle the case containing writing implements. It consists of two parts, a receptacle for the pens, and a box for the ink. It is sometimes made of ebony or some other hard wood, but generally of metal brass, copper, or silver—ofte…"
      }
    },
