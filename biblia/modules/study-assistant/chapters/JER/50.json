    "costumbres": {
      "c-0ec33e4973fb160c": {
        "fuente": {
          "entradaId": "freeman-559",
          "modulo": "freeman-manners-customs"
        },
        "texto": "Babylon is taken, Bel is confounded, Merodach is broken in pieces; her idols are confounded, her images are broken in pieces."
      },
      "c-9ff8f6dee2aa1be2": {
        "fuente": {
          "entradaId": "freeman-560",
          "modulo": "freeman-manners-customs"
        },
        "texto": "This is a beautiful Orientalism denoting submission, and probably has some relation to the custom of giving the hand in pledge of a covenant. See note on Proverbs 11:21 (#461). There are several texts where the expression is used: “We have given the hand to the Egyptians, and to…"
      }
