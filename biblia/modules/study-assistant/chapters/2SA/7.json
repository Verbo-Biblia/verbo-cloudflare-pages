    "historia": {
      "h-2bfe348be2cf6883": {
        "fuente": {
          "claimIds": [
            "maclear-attributed-political-context"
          ],
          "contrastSourceIds": [],
          "entradaId": "maclear-1894-b09-c02",
          "fichaId": "maclear-asst-2sa-5-jerusalem-capital",
          "libroSeccion": "Book 9, Chapter 2 — David’s Reign at Jerusalem",
          "modulo": "maclear-class-book-ot-history",
          "recursoId": "maclear-asst-2sa-5-jerusalem-capital"
        },
        "texto": "Maclear explica la elección de Jerusalén como un intento de unir las tribus: la sitúa en el encuentro de Judá y Benjamín y contrasta su posición con Hebrón. Relaciona después el traslado del arca con la consagración religiosa de la nueva capital. Esta interpretación geográfica y política complementa 2 Samuel 5–7 y pertenece a la reconstrucción histórica del autor.",
        "tipo": "political-context",
        "traduccion": {
          "resourceId": "maclear-asst-2sa-5-jerusalem-capital",
          "sourceHash": "d5ae0eecbeaa564cdb6d67db86eca7679ce8fd055f5a700cd7bab99a8f56efc3",
          "sourceLanguage": "es"
        },
        "traducciones": {
          "en": "Maclear explains the choice of Jerusalem as an effort to unite the tribes: he places it at the meeting point of Judah and Benjamin and contrasts its position with Hebron. He then relates the transfer of the ark to the religious consecration of the new capital. This geographical and political interpretation complements 2 Samuel 5–7 and belongs to the author’s historical reconstruction."
        }
      },
      "h-4da0138e6d0707fc": {
        "fuente": {
          "entradaId": "2SA:libro",
          "libroSeccion": "2SA:libro",
          "modulo": "book-classification-ot"
        },
        "texto": "Reinado de David. Sin introducción propia de JFB ni Poole en el repositorio (probablemente cubierta en conjunto bajo la introducción de 1 Samuel).",
        "tipo": "circunstancia",
        "traduccion": {
          "resourceId": "2SA:libro",
          "sourceHash": "5d5fe66d51c458d5f12194ba1611bdaec1c55d4c07d4df282d64b57949ce9e07",
          "sourceLanguage": "es"
        }
      }
    }
  },
