  "resources": {
    "costumbres": {
      "c-c88b363ab63c5a4d": {
        "fuente": {
          "entradaId": "freeman-274",
          "modulo": "freeman-manners-customs"
        },
        "texto": "“After the year was expired” is literally “at the return of the year,” that is, in the spring. This was the time of the year for the commencement or renewal of military movements, the season for severe storms being over."
      },
      "c-ee7c912c528afe45": {
        "fuente": {
          "entradaId": "freeman-275",
          "modulo": "freeman-manners-customs"
        },
        "texto": "It came to pass in an eveningtide, that David arose from off his bed, and walked upon the roof of the king’s house: and from the roof he saw a woman washing herself."
      }
    },
