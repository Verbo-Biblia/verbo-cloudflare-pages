  "mundo": {
    "pantallas": {
      "pueblo": "El campamento de Israel",
      "taller": "Tienda de mando",
      "tienda": "Mercado",
      "cronista": "Casa del escriba",
      "arena": "Campo de prácticas",
      "mapa": "Mapa de Canaán",
      "puerta": "Salida del campamento",
      "moneda": "siclos",
      "campaña": "Conquista",
      "escaramuza": "Combate de práctica"
    },
    "actos": {
      "1": {
        "titulo": "Primera parte: Cruzar el Jordán",
        "texto": "Cuarenta años en el desierto quedaron atrás. El Jordán separa al pueblo de la tierra prometida (Josué 1-4)."
      },
      "2": {
        "titulo": "Segunda parte: Jericó, Hai y el sur",
        "texto": "Las ciudades de Canaán oyen lo que Dios ha hecho y se unen contra Israel (Josué 6-10)."
      },
      "3": {
        "titulo": "Tercera parte: El norte y Sion",
        "texto": "Los reyes del norte salen con muchos carros y caballos (Josué 11). Y una fortaleza quedará en pie por muchos años, hasta los días de David."
      }
    },
    "mazmorras": {
      "m01": {
        "nombre": "Las llanuras de Moab",
        "descripcion": "El pueblo acampa frente a Jericó, al otro lado del Jordán (Números 22:1).",
        "partidas": [
          {
            "antes": "Antes de cruzar el Jordán, el campamento debe quedar seguro en las llanuras de Moab (Números 33:49).",
            "despues": "El campamento quedó seguro. Ya se puede mirar hacia el Jordán."
          }
        ],
        "conquista": "Las llanuras de Moab ya es tuya.",
        "perdida": "El enemigo recuperó las llanuras de Moab."
      },
      "m02": {
        "nombre": "El campamento de Sitim",
        "descripcion": "El último campamento antes de cruzar. De aquí salen los espías (Josué 2:1).",
        "partidas": [
          {
            "antes": "Desde Sitim, Josué envía dos espías a reconocer la tierra (Josué 2:1).",
            "despues": "Los espías vuelven con buenas noticias: los habitantes de la tierra tienen miedo de Israel (Josué 2:24)."
          },
          {
            "antes": "Los amalecitas rondan el campamento buscando botín.",
            "despues": "El campamento está listo para cruzar el Jordán."
          }
        ],
        "conquista": "El campamento de Sitim ya es tuya.",
        "perdida": "El enemigo recuperó el campamento de Sitim."
      },
      "m03": {
        "nombre": "El vado del Jordán",
        "descripcion": "El río va crecido: es tiempo de la siega (Josué 3:15).",
        "partidas": [
          {
            "antes": "El Jordán va crecido. Asegura la orilla antes de cruzar (Josué 3:15).",
            "despues": "Cuando los sacerdotes entraron al río con el arca, las aguas se detuvieron (Josué 3:16)."
          },
          {
            "antes": "Del otro lado esperan los cananeos.",
            "despues": "Doce piedras quedan en Gilgal como memorial del paso (Josué 4:20)."
          }
        ],
        "conquista": "El vado del Jordán ya es tuya.",
        "perdida": "El enemigo recuperó el vado del Jordán."
      },
      "m04": {
        "nombre": "Jericó",
        "descripcion": "La ciudad estaba cerrada; nadie entraba ni salía (Josué 6:1).",
        "partidas": [
          {
            "antes": "Jericó está cerrada. El pueblo rodea la ciudad una vez cada día (Josué 6:3).",
            "despues": "Seis días rodearon la ciudad, y volvieron al campamento (Josué 6:14)."
          },
          {
            "antes": "El séptimo día, siete vueltas. Cuando suenen las trompetas, todo el pueblo gritará (Josué 6:15-16).",
            "despues": "El muro se derrumbó (Josué 6:20). Rahab y su familia fueron salvadas (Josué 6:25)."
          }
        ],
        "conquista": "Jericó cayó.",
        "perdida": "El enemigo recuperó Jericó."
      },
      "m05": {
        "nombre": "Hai",
        "descripcion": "Una ciudad pequeña en la colina, donde Israel aprendió una lección dura (Josué 7-8).",
        "partidas": [
          {
            "antes": "Antes de subir a Hai, hay que quitar el pecado del campamento: Acán tomó lo prohibido (Josué 7).",
            "despues": "El campamento quedó limpio. Ahora sí, a Hai (Josué 8:1)."
          },
          {
            "antes": "Josué prepara una emboscada detrás de la ciudad (Josué 8:2).",
            "despues": "Los de Hai salieron tras Israel y dejaron la ciudad abierta (Josué 8:17)."
          },
          {
            "antes": "Josué extiende la lanza hacia Hai: es la señal (Josué 8:18).",
            "despues": "Hai fue tomada. En el monte Ebal se leyó la ley ante todo el pueblo (Josué 8:30-35)."
          }
        ],
        "conquista": "Hai ya es tuya.",
        "perdida": "El enemigo recuperó Hai."
      },
      "m06": {
        "nombre": "Gabaón y el valle de Ajalón",
        "descripcion": "Cinco reyes atacan a Gabaón, que hizo pacto con Israel (Josué 9-10).",
        "partidas": [
          {
            "antes": "Cinco reyes amorreos atacan Gabaón, aliada de Israel (Josué 10:5).",
            "despues": "Josué subió desde Gilgal toda la noche y los tomó por sorpresa (Josué 10:9)."
          },
          {
            "antes": "La batalla se alarga. Josué ora para que el sol se detenga sobre Gabaón (Josué 10:12).",
            "despues": "El sol se detuvo casi un día entero. Nunca hubo un día como aquel (Josué 10:13-14)."
          }
        ],
        "conquista": "Gabaón y el valle de Ajalón ya es tuya.",
        "perdida": "El enemigo recuperó Gabaón y el valle de Ajalón."
      },
      "m07": {
        "nombre": "La bajada de Bet-horón",
        "descripcion": "El camino por donde huyeron los amorreos (Josué 10:10-11).",
        "partidas": [
          {
            "antes": "Los amorreos huyen por la bajada de Bet-horón (Josué 10:10).",
            "despues": "Grandes piedras cayeron del cielo sobre los que huían (Josué 10:11)."
          },
          {
            "antes": "Sigue al enemigo por el camino de Bet-horón.",
            "despues": "El enemigo se dispersa por el camino."
          },
          {
            "antes": "Los últimos amorreos se hacen fuertes en el paso.",
            "despues": "El paso quedó libre."
          }
        ],
        "conquista": "La bajada de Bet-horón ya es tuya.",
        "perdida": "El enemigo recuperó la bajada de Bet-horón."
      },
      "m08": {
        "nombre": "La cueva de Maceda",
        "descripcion": "La cueva donde se escondieron los cinco reyes (Josué 10:16).",
        "partidas": [
          {
            "antes": "Los cinco reyes se esconden en una cueva en Maceda (Josué 10:16).",
            "despues": "Josué manda tapar la entrada de la cueva con grandes piedras (Josué 10:18)."
          },
          {
            "antes": "Los soldados de los reyes intentan llegar a sus ciudades (Josué 10:19).",
            "despues": "Pocos lograron escapar (Josué 10:20)."
          },
          {
            "antes": "Los reyes son sacados de la cueva (Josué 10:22).",
            "despues": "Josué animó al pueblo: no teman ni desmayen, esfuércense y sean valientes (Josué 10:25)."
          }
        ],
        "conquista": "La cueva de Maceda ya es tuya.",
        "perdida": "El enemigo recuperó la cueva de Maceda."
      },
      "m09": {
        "nombre": "Hazor",
        "descripcion": "La cabeza de todos los reinos del norte (Josué 11:10).",
        "partidas": [
          {
            "antes": "Jabín, rey de Hazor, reúne a los reyes del norte con muchos carros y caballos (Josué 11:1-4).",
            "despues": "El ejército del norte retrocede."
          },
          {
            "antes": "Junto a las aguas de Merom, Dios le dice a Josué que no tenga temor (Josué 11:6).",
            "despues": "Israel cayó sobre ellos de repente (Josué 11:7)."
          },
          {
            "antes": "Hazor era la cabeza de todos estos reinos (Josué 11:10).",
            "despues": "Hazor fue tomada."
          }
        ],
        "conquista": "Hazor ya es tuya.",
        "perdida": "El enemigo recuperó Hazor."
      },
      "m10": {
        "nombre": "La fortaleza de Sion",
        "descripcion": "La fortaleza de los jebuseos, que cayó en los días de David (2 Samuel 5:6-7).",
        "partidas": [
          {
            "antes": "Los jebuseos siguieron en Jerusalén: Judá no pudo echarlos (Josué 15:63).",
            "despues": "Pasan los años; la fortaleza sigue en pie."
          },
          {
            "antes": "Mucho después, el rey David sube contra la fortaleza de los jebuseos (2 Samuel 5:6).",
            "despues": "Los jebuseos confían en sus muros."
          },
          {
            "antes": "Los jebuseos se burlan: creen que la fortaleza no caerá (2 Samuel 5:6).",
            "despues": "David tomó la fortaleza de Sion, que es la ciudad de David (2 Samuel 5:7)."
          }
        ],
        "conquista": "La fortaleza de Sion ya es tuya.",
        "perdida": "El enemigo recuperó la fortaleza de Sion."
      }
